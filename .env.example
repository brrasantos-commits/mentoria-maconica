# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Security
SESSION_SECRET_KEY=generate-a-random-secret-key-here

# Application Settings
MAX_VIDEO_SIZE_MB=100
MAX_TEXT_CHARS_PER_MATERIAL=4000

# Audio Processing
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# Data Directory (optional, defaults to ./data)
APP_DATA_DIR=./data

# Email Configuration (for password reset)
# Option 1: SendGrid (Recommended for Railway - works with network restrictions)
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Sales Pitch AI

# Option 2: SMTP (Fallback - may not work on Railway due to network restrictions)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@example.com